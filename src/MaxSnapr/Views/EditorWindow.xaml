<Window x:Class="MaxSnapr.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ed="clr-namespace:MaxSnapr.Editor"
        xmlns:v="clr-namespace:MaxSnapr.Views"
        Title="MaxSnapr" Width="1320" Height="860" MinWidth="900" MinHeight="560"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen" AllowDrop="True">
    <Window.Resources>
        <Style x:Key="TopIconButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu bar -->
        <Border Grid.Row="0" Background="{DynamicResource Bg.Toolbar}" Padding="6,2">
            <DockPanel>
                <Image Source="{x:Static v:EditorWindow.Logo}" Width="18" Height="18" Margin="4,0,8,0" DockPanel.Dock="Left"/>
                <Menu x:Name="MainMenu" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <MenuItem Header="_Archivo">
                        <MenuItem Header="Nueva _captura" InputGestureText="Ctrl+Mayús+N" Click="NewCapture_Click"/>
                        <MenuItem Header="_Nueva imagen…" InputGestureText="Ctrl+N" Click="NewImage_Click"/>
                        <MenuItem Header="Nueva imagen desde el _portapapeles" Click="NewFromClipboard_Click"/>
                        <MenuItem Header="_Abrir…" InputGestureText="Ctrl+O" Click="Open_Click"/>
                        <Separator/>
                        <MenuItem Header="_Guardar en la biblioteca" InputGestureText="Ctrl+S" Click="Save_Click"/>
                        <MenuItem Header="Guardar _como…" InputGestureText="Ctrl+Mayús+S" Click="SaveAs_Click"/>
                        <MenuItem Header="Exportar como _PDF…" Click="ExportPdf_Click"/>
                        <MenuItem Header="Exportar la bandeja como PDF de _varias páginas…" Click="ExportTrayPdf_Click"/>
                        <MenuItem Header="C_rear">
                            <MenuItem Header="Combinar en una _plantilla…" InputGestureText="Ctrl+Alt+C" Click="Combine_Click"/>
                            <MenuItem Header="Crear _vídeo a partir de imágenes…" Click="ImagesToVideo_Click"/>
                            <MenuItem Header="Exportación por _lotes…" Click="Batch_Click"/>
                            <MenuItem Header="Guardar como _plantilla…" Click="SaveAsTemplate_Click"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="_Imprimir…" InputGestureText="Ctrl+P" Click="Print_Click"/>
                        <MenuItem Header="Impresión _rápida" InputGestureText="Ctrl+Mayús+P" Click="QuickPrint_Click"/>
                        <MenuItem Header="Imprimir a tamaño real (sin ajustar)…" Click="PrintActual_Click"/>
                        <MenuItem Header="Imprimir en horizontal…" Click="PrintLandscape_Click"/>
                        <MenuItem Header="Mostrar en la _carpeta" Click="ShowInFolder_Click"/>
                        <Separator/>
                        <MenuItem Header="Pre_ferencias…" Click="Preferences_Click"/>
                        <MenuItem Header="_Cerrar el editor" Click="CloseEditor_Click"/>
                        <MenuItem Header="_Salir de MaxSnapr" Click="Exit_Click"/>
                    </MenuItem>
                    <MenuItem Header="_Edición">
                        <MenuItem Header="_Deshacer" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
                        <MenuItem Header="_Rehacer" InputGestureText="Ctrl+Y" Click="Redo_Click"/>
                        <Separator/>
                        <MenuItem Header="Cor_tar" InputGestureText="Ctrl+X" Click="Cut_Click"/>
                        <MenuItem Header="_Copiar" InputGestureText="Ctrl+C" Click="Copy_Click"/>
                        <MenuItem Header="Copiar _todo" InputGestureText="Ctrl+Mayús+C" Click="CopyAll_Click"/>
                        <MenuItem Header="_Pegar" InputGestureText="Ctrl+V" Click="Paste_Click"/>
                        <MenuItem Header="_Duplicar" InputGestureText="Ctrl+D" Click="Duplicate_Click"/>
                        <MenuItem Header="_Eliminar" InputGestureText="Supr" Click="Delete_Click"/>
                        <Separator/>
                        <MenuItem Header="_Seleccionar todos los objetos" InputGestureText="Ctrl+A" Click="SelectAll_Click"/>
                        <MenuItem Header="Compactar la selección" InputGestureText="Ctrl+T" Click="CompactSel_Click"/>
                        <MenuItem Header="Compactar todo" InputGestureText="Ctrl+Mayús+T" Click="Flatten_Click"/>
                        <MenuItem Header="Duplicar la imagen" InputGestureText="Ctrl+Mayús+D" Click="DuplicateImage_Click"/>
                        <MenuItem Header="Detalles…" InputGestureText="Alt+Intro" Click="Details_Click"/>
                        <MenuItem Header="Anular la selección" InputGestureText="Esc" Click="Deselect_Click"/>
                        <Separator/>
                        <MenuItem Header="A_grupar" InputGestureText="Ctrl+G" Click="Group_Click"/>
                        <MenuItem Header="Desagr_upar" InputGestureText="Ctrl+Mayús+G" Click="Ungroup_Click"/>
                        <MenuItem Header="_Organizar">
                            <MenuItem Header="Traer al frente" InputGestureText="Ctrl+Mayús+]" Click="BringFront_Click"/>
                            <MenuItem Header="Traer adelante" InputGestureText="Ctrl+]" Click="BringForward_Click"/>
                            <MenuItem Header="Enviar atrás" InputGestureText="Ctrl+[" Click="SendBackward_Click"/>
                            <MenuItem Header="Enviar al fondo" InputGestureText="Ctrl+Mayús+[" Click="SendBack_Click"/>
                        </MenuItem>
                        <MenuItem Header="_Alinear">
                            <MenuItem Header="Izquierda" Tag="L" Click="Align_Click"/>
                            <MenuItem Header="Centro" Tag="C" Click="Align_Click"/>
                            <MenuItem Header="Derecha" Tag="R" Click="Align_Click"/>
                            <MenuItem Header="Superior" Tag="T" Click="Align_Click"/>
                            <MenuItem Header="Medio" Tag="M" Click="Align_Click"/>
                            <MenuItem Header="Inferior" Tag="B" Click="Align_Click"/>
                        </MenuItem>
                        <MenuItem Header="_Voltear objetos">
                            <MenuItem Header="Horizontalmente" Tag="H" Click="FlipObjects_Click"/>
                            <MenuItem Header="Verticalmente" Tag="V" Click="FlipObjects_Click"/>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="_Imagen">
                        <MenuItem Header="_Recortar" InputGestureText="C" Click="CropTool_Click"/>
                        <MenuItem Header="Recortar a la _selección" Click="CropToSelection_Click"/>
                        <MenuItem Header="Recortar _bordes sobrantes" Click="AutoTrim_Click"/>
                        <MenuItem Header="Ajustar el lienzo a los objetos" InputGestureText="Ctrl+;" Click="FitCanvas_Click"/>
                        <Separator/>
                        <MenuItem Header="Cambiar _tamaño de la imagen…" InputGestureText="Ctrl+R" Click="Resize_Click"/>
                        <MenuItem Header="Tamaño del _lienzo…" Click="CanvasSize_Click"/>
                        <MenuItem Header="_Color del lienzo…" Click="CanvasColor_Click"/>
                        <Separator/>
                        <MenuItem Header="_Girar">
                            <MenuItem Header="90° a la derecha" Tag="90" Click="Rotate_Click"/>
                            <MenuItem Header="90° a la izquierda" Tag="270" Click="Rotate_Click"/>
                            <MenuItem Header="180°" Tag="180" Click="Rotate_Click"/>
                            <MenuItem Header="Ángulo personalizado…" Click="RotateCustom_Click"/>
                        </MenuItem>
                        <MenuItem Header="_Voltear">
                            <MenuItem Header="Horizontalmente" Tag="H" Click="Flip_Click"/>
                            <MenuItem Header="Verticalmente" Tag="V" Click="Flip_Click"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="_Aplanar todos los objetos" Click="Flatten_Click"/>
                        <MenuItem Header="_Extraer texto (OCR)" Click="Ocr_Click"/>
                        <MenuItem Header="Ocultación _inteligente…" Click="SmartRedact_Click"/>
                        <MenuItem Header="E_ditar el texto de la imagen" Click="EditText_Click"/>
                        <MenuItem Header="Si_mplificar…" Click="Simplify_Click"/>
                    </MenuItem>
                    <MenuItem Header="_Compartir">
                        <MenuItem Header="Copiar _todo al portapapeles" InputGestureText="Ctrl+Mayús+C" Click="CopyAll_Click"/>
                        <MenuItem Header="_Guardar como archivo…" Click="SaveAs_Click"/>
                        <MenuItem Header="Enviar por _correo…" Click="Email_Click"/>
                        <MenuItem Header="Abrir con _otro programa…" Click="OpenWith_Click"/>
                        <MenuItem Header="_Imprimir…" Click="Print_Click"/>
                    </MenuItem>
                    <MenuItem Header="_Ver">
                        <MenuItem Header="_Acercar" InputGestureText="Ctrl++" Click="ZoomIn_Click"/>
                        <MenuItem Header="A_lejar" InputGestureText="Ctrl+-" Click="ZoomOut_Click"/>
                        <MenuItem Header="Tamaño _real (100 %)" InputGestureText="Ctrl+0" Click="Zoom100_Click"/>
                        <MenuItem Header="Ajustar a la _ventana" InputGestureText="Ctrl+9" Click="ZoomFit_Click"/>
                        <Separator/>
                        <MenuItem x:Name="ShowTrayItem" Header="Mostrar la _bandeja" IsCheckable="True" Click="ToggleTray_Click"/>
                        <MenuItem x:Name="ShowPropsItem" Header="Mostrar el panel de _propiedades" IsCheckable="True" Click="ToggleProps_Click"/>
                        <MenuItem Header="_Biblioteca" InputGestureText="Ctrl+L" Click="Library_Click"/>
                        <MenuItem Header="Te_mas de herramientas…" Click="Themes_Click"/>
                        <Separator/>
                        <MenuItem Header="_Tema">
                            <MenuItem Header="Oscuro" Tag="Dark" Click="Theme_Click"/>
                            <MenuItem Header="Claro" Tag="Light" Click="Theme_Click"/>
                            <MenuItem Header="Según el sistema" Tag="System" Click="Theme_Click"/>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="Ay_uda">
                        <MenuItem Header="_Atajos de teclado" InputGestureText="F1" Click="Shortcuts_Click"/>
                        <MenuItem Header="_Bienvenida y consejos" Click="Welcome_Click"/>
                        <MenuItem Header="Abrir la carpeta de _registro" Click="OpenLog_Click"/>
                        <Separator x:Name="SupportSeparator"/>
                        <MenuItem x:Name="SupportMenu" Header="A_poyar MaxSnapr…" Click="Support_Click"/>
                        <MenuItem Header="Acerca _de MaxSnapr" Click="About_Click"/>
                    </MenuItem>
                </Menu>
                <TextBlock x:Name="TitleText" Foreground="{DynamicResource Fg.Secondary}" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource Bg.Toolbar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1" Padding="10,6">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button Style="{StaticResource CaptureButton}" Click="NewCapture_Click" Height="40" Padding="14,0" ToolTip="Nueva captura">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE722;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="Capturar" Foreground="White" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <ToggleButton x:Name="LibraryToggle" Height="40" Margin="8,0,0,0" Padding="12,0" Click="Library_Click" ToolTip="Biblioteca (Ctrl+L)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="17" VerticalAlignment="Center"/>
                            <TextBlock Text="Biblioteca" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <Border Width="1" Background="{DynamicResource Line}" Margin="12,4"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource TopIconButton}" Click="Undo_Click" ToolTip="Deshacer (Ctrl+Z)">
                        <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFont}" FontSize="15"/>
                    </Button>
                    <Button Style="{StaticResource TopIconButton}" Click="Redo_Click" ToolTip="Rehacer (Ctrl+Y)">
                        <TextBlock Text="&#xE7A6;" FontFamily="{StaticResource IconFont}" FontSize="15"/>
                    </Button>
                    <Border Width="1" Background="{DynamicResource Line}" Margin="10,4"/>
                    <Button Style="{StaticResource OutlineButton}" Click="CopyAll_Click" ToolTip="Copiar la imagen con todos los objetos (Ctrl+Mayús+C)" Height="36">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Copiar todo" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ShareButton" Style="{StaticResource AccentButton}" Click="Share_Click" Margin="8,0,0,0" Height="36">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72D;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="Compartir" Foreground="White" Margin="8,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ScrollViewer x:Name="ToolScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="ToolScroll_Wheel">
                    <StackPanel x:Name="ToolStrip" Orientation="Horizontal" VerticalAlignment="Center"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Workspace -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="PropsColumn" Width="300"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="CanvasHost" Background="{DynamicResource Bg.Canvas}">
                <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ed:EditorCanvas x:Name="Canvas" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ScrollViewer>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="&#xE722;" FontFamily="{StaticResource IconFont}" FontSize="56" Foreground="{DynamicResource Fg.Secondary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="No hay ninguna captura abierta" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,4" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyHint" Foreground="{DynamicResource Fg.Secondary}" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button Style="{StaticResource CaptureButton}" Content="Nueva captura" Foreground="White" Click="NewCapture_Click" Padding="18,8"/>
                        <Button Style="{StaticResource OutlineButton}" Content="Abrir archivo…" Click="Open_Click" Margin="8,0,0,0"/>
                        <Button Style="{StaticResource OutlineButton}" Content="Pegar imagen" Click="NewFromClipboard_Click" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <!-- Floating apply bar for crop -->
                <Border x:Name="CropBar" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,12,0,0"
                        Background="{DynamicResource Bg.Raised}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Proporción:" VerticalAlignment="Center" Margin="6,0" Foreground="{DynamicResource Fg.Secondary}"/>
                        <ComboBox x:Name="CropAspect" Width="110" SelectionChanged="CropAspect_Changed">
                            <ComboBoxItem Content="Libre" Tag="0" IsSelected="True"/>
                            <ComboBoxItem Content="1:1" Tag="1"/>
                            <ComboBoxItem Content="4:3" Tag="1.3333"/>
                            <ComboBoxItem Content="16:9" Tag="1.7778"/>
                            <ComboBoxItem Content="3:2" Tag="1.5"/>
                            <ComboBoxItem Content="9:16" Tag="0.5625"/>
                        </ComboBox>
                        <Button Style="{StaticResource AccentButton}" Content="Aplicar recorte" Margin="8,0,0,0" Click="ApplyCrop_Click"/>
                        <Button Style="{StaticResource OutlineButton}" Content="Restablecer" Margin="6,0,0,0" Click="ResetCrop_Click"/>
                    </StackPanel>
                </Border>
                <v:VideoView x:Name="VideoPane" Visibility="Collapsed"/>
                <v:LibraryView x:Name="LibraryPane" Visibility="Collapsed"/>
            </Grid>

            <!-- Properties / effects panel -->
            <Border Grid.Column="1" x:Name="PropsPanel" Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
                <TabControl x:Name="SideTabs" Padding="0">
                    <TabItem Header="Propiedades">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="PropsHost" Margin="14,4,14,16"/>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Efectos">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="EffectsHost" Margin="14,4,14,16"/>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- Recent captures tray -->
        <Border Grid.Row="3" x:Name="TrayPanel" Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <DockPanel Height="118">
                <StackPanel DockPanel.Dock="Left" Width="34" VerticalAlignment="Center">
                    <TextBlock Text="RECIENTES" FontSize="10" Foreground="{DynamicResource Fg.Secondary}" HorizontalAlignment="Center">
                        <TextBlock.LayoutTransform><RotateTransform Angle="-90"/></TextBlock.LayoutTransform>
                    </TextBlock>
                </StackPanel>
                <ListBox x:Name="Tray" ItemContainerStyle="{StaticResource CardItem}" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionMode="Single"
                         SelectionChanged="Tray_SelectionChanged" PreviewMouseLeftButtonDown="Tray_PreviewMouseDown" PreviewMouseMove="Tray_PreviewMouseMove"
                         AllowDrop="True" Drop="Tray_Drop" KeyDown="Tray_KeyDown">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="112" ToolTip="{Binding Name}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="74"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border CornerRadius="4" Background="{DynamicResource Bg.Canvas}">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <TextBlock Text="&#xE718;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource Accent}"
                                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Pinned}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border CornerRadius="9" Background="#B0000000" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4">
                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMedia}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="11" Margin="2,4,2,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Fg.Secondary}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Abrir" Click="TrayOpen_Click"/>
                            <MenuItem Header="Copiar" Click="TrayCopy_Click"/>
                            <MenuItem Header="Cambiar el nombre…" Click="TrayRename_Click"/>
                            <MenuItem Header="Fijar / soltar" Click="TrayPin_Click"/>
                            <MenuItem Header="Mostrar en la carpeta" Click="TrayShowInFolder_Click"/>
                            <Separator/>
                            <MenuItem Header="Quitar de la bandeja" Click="TrayRemove_Click"/>
                            <MenuItem Header="Quitar todas las no fijadas" Click="TrayClear_Click"/>
                            <MenuItem Header="Eliminar de la biblioteca" Click="TrayDelete_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="4" Background="{DynamicResource Bg.Toolbar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="10,3">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource TopIconButton}" Width="28" Height="26" Click="ZoomOut_Click" ToolTip="Alejar">
                        <TextBlock Text="&#xE71F;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                    </Button>
                    <Slider x:Name="ZoomSlider" Width="120" Minimum="-3" Maximum="3" Value="0" VerticalAlignment="Center" ValueChanged="ZoomSlider_ValueChanged"/>
                    <Button Style="{StaticResource TopIconButton}" Width="28" Height="26" Click="ZoomIn_Click" ToolTip="Acercar">
                        <TextBlock Text="&#xE8A3;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                    </Button>
                    <Button x:Name="ZoomLabel" Style="{StaticResource FlatButton}" Width="64" Padding="4,2" Click="Zoom100_Click" ToolTip="Clic: 100 %"/>
                    <Button Style="{StaticResource FlatButton}" Padding="8,2" Click="ZoomFit_Click" Content="Ajustar"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SizeText" Foreground="{DynamicResource Fg.Secondary}" Margin="0,0,18,0"/>
                    <TextBlock x:Name="CursorText" Foreground="{DynamicResource Fg.Secondary}" Margin="0,0,18,0"/>
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource Fg.Secondary}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
