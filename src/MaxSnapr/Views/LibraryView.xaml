<UserControl x:Class="MaxSnapr.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Bg.Window}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <!-- Filters -->
        <Border Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10,12">
                    <TextBlock Text="Biblioteca" FontSize="18" FontWeight="SemiBold" Margin="6,0,0,10"/>
                    <ListBox x:Name="Filters" SelectionChanged="Filters_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Padding="8,6" CornerRadius="6" Background="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Bg.Hover}"/></Trigger>
                                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Bg.Selected}"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Grid -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Padding="14,10" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBox x:Name="Search" TextChanged="Search_TextChanged" Padding="30,5,6,5"/>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Fg.Secondary}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBlock x:Name="SearchHint" Text="Buscar por nombre, etiqueta o aplicación" Foreground="{DynamicResource Fg.Disabled}" Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <WrapPanel>
                        <ComboBox x:Name="Sort" Width="150" SelectionChanged="Sort_SelectionChanged">
                            <ComboBoxItem Content="Más recientes" IsSelected="True"/>
                            <ComboBoxItem Content="Más antiguas"/>
                            <ComboBoxItem Content="Nombre"/>
                            <ComboBoxItem Content="Tamaño"/>
                        </ComboBox>
                        <Slider x:Name="ThumbSize" Width="90" Minimum="110" Maximum="320" Value="170" Margin="12,0,0,0" VerticalAlignment="Center" ValueChanged="ThumbSize_ValueChanged" ToolTip="Tamaño de las miniaturas"/>
                        <Button Content="Importar…" Style="{StaticResource OutlineButton}" Margin="12,0,0,0" Click="Import_Click"/>
                        <Button Content="Abrir la carpeta" Style="{StaticResource OutlineButton}" Margin="6,0,0,0" Click="OpenFolder_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <TextBlock x:Name="CountText" DockPanel.Dock="Top" Margin="18,8,0,0" Foreground="{DynamicResource Fg.Secondary}"/>
            <ListBox x:Name="ItemsGrid" ItemContainerStyle="{StaticResource CardItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="10"
                     SelectionMode="Extended" SelectionChanged="Grid_SelectionChanged" MouseDoubleClick="Grid_MouseDoubleClick" KeyDown="Grid_KeyDown">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="{Binding DataContext.ThumbWidth, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Border CornerRadius="6" Background="{DynamicResource Bg.Canvas}" Height="{Binding DataContext.ThumbHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <TextBlock Text="{Binding Name}" Margin="2,6,2,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Subtitle}" Margin="2,1,2,2" FontSize="11" Foreground="{DynamicResource Fg.Secondary}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Details -->
        <Border Grid.Column="2" Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Details" Margin="14,12">
                    <TextBlock Text="Detalles" FontSize="16" FontWeight="SemiBold"/>
                    <Border CornerRadius="6" Background="{DynamicResource Bg.Canvas}" Height="150" Margin="0,10,0,0">
                        <Image x:Name="DetailImage" Stretch="Uniform" Margin="4"/>
                    </Border>
                    <TextBlock Text="Nombre" Style="{StaticResource Caption}"/>
                    <TextBox x:Name="DetailName" LostFocus="DetailName_LostFocus" KeyDown="Detail_KeyDown"/>
                    <TextBlock Text="Etiquetas (separadas por comas)" Style="{StaticResource Caption}"/>
                    <TextBox x:Name="DetailTags" LostFocus="DetailTags_LostFocus" KeyDown="Detail_KeyDown"/>
                    <TextBlock x:Name="DetailInfo" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Abrir en el editor" Style="{StaticResource AccentButton}" Margin="0,0,6,6" Click="Open_Click"/>
                        <Button Content="Copiar" Style="{StaticResource OutlineButton}" Margin="0,0,6,6" Click="Copy_Click"/>
                        <Button Content="Mostrar en la carpeta" Style="{StaticResource OutlineButton}" Margin="0,0,6,6" Click="Reveal_Click"/>
                        <Button Content="Exportar PDF de la selección…" Style="{StaticResource OutlineButton}" Margin="0,0,6,6" Click="ExportPdf_Click"/>
                        <Button Content="Combinar en plantilla…" Style="{StaticResource OutlineButton}" Margin="0,0,6,6" Click="Combine_Click"/>
                        <Button Content="Vídeo con las imágenes…" Style="{StaticResource OutlineButton}" Margin="0,0,6,6" Click="Slides_Click"/>
                        <Button Content="Exportación por lotes…" Style="{StaticResource OutlineButton}" Margin="0,0,6,6" Click="Batch_Click"/>
                        <Button Content="Eliminar" Style="{StaticResource OutlineButton}" Margin="0,0,6,6" Click="Delete_Click"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
