<?xml version="1.0" encoding="utf-8"?>
<!--
  Prudent obfuscation for release builds (dotnet publish -p:Obfuscate=true).
  Renames private and internal types, methods and fields so decompiled code is hard to follow, and keeps
  everything that is looked up by name at run time:
  - public API: types and members used by XAML, data binding and other assemblies;
  - properties and events: settings, library and .snapr documents are JSON keyed by property name;
  - P/Invoke declarations: their names are the Windows entry points;
  - names referenced from compiled XAML (AnalyzeXaml).
-->
<Obfuscator>
  <Var name="InPath" value="in" />
  <Var name="OutPath" value="out" />
  <Var name="KeepPublicApi" value="true" />
  <Var name="HidePrivateApi" value="true" />
  <Var name="RenameProperties" value="false" />
  <Var name="RenameEvents" value="false" />
  <Var name="RenameFields" value="true" />
  <Var name="AnalyzeXaml" value="true" />
  <Var name="HideStrings" value="false" />
  <Var name="ReuseNames" value="true" />
  <Var name="UseUnicodeNames" value="false" />
  <Var name="SuppressIldasm" value="true" />
  <Var name="XmlMapping" value="false" />

  <Module file="$(InPath)\MaxSnapr.dll" />
</Obfuscator>
